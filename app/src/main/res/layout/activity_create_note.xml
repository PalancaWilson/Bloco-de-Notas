<?xml version="1.0" encoding="utf-8"?>
<!-- Ecra para criar ou editar uma nota. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".CreateNoteActivity">

    <!-- Campo onde o utilizador escreve o titulo da nota. -->
    <EditText
        android:id="@+id/campoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dica_titulo"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1" />

    <!-- Campo onde o utilizador escreve o texto da nota. -->
    <EditText
        android:id="@+id/campoTexto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="@string/dica_texto"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine" />

    <!-- Botoes para cancelar ou confirmar a nota. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botaoCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancelar" />

        <Button
            android:id="@+id/botaoOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/ok" />

    </LinearLayout>

</LinearLayout>
